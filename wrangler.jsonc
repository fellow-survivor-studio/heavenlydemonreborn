// Cloudflare Workers static hosting for https://fellowsurvivor.com/heavenlydemonreborn/
// Runs alongside GitHub Pages until the switch.
{
  "name": "fellowsurvivor-heavenlydemonreborn",
  "compatibility_date": "2026-11-01",
  // Copies the published files into .cf-dist/heavenlydemonreborn/ so they are served under /heavenlydemonreborn/.
  "build": { "command": "sh scripts/cloudflare-build.sh" },
  "assets": {
    "directory": "./.cf-dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": true,
  // Branch and pull-request previews (wrangler preview needs this block, even empty).
  "previews": {},
  // Test address while GitHub Pages still serves fellowsurvivor.com.
  "routes": [
    // Exact /heavenlydemonreborn (redirects to /heavenlydemonreborn/) and everything under /heavenlydemonreborn/ only, so the main
    // site's files that merely start with "heavenlydemonreborn" (e.g. /heavenlydemonreborn.css) stay with the main site.
    { "pattern": "new.fellowsurvivor.com/heavenlydemonreborn", "zone_name": "fellowsurvivor.com" },
    { "pattern": "new.fellowsurvivor.com/heavenlydemonreborn/*", "zone_name": "fellowsurvivor.com" }
  ]
}
