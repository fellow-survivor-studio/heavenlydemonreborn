// Cloudflare Workers static hosting for https://fellowsurvivor.com/heavenlydemonreborn/
// Runs alongside GitHub Pages until the switch.
{
  "name": "fellowsurvivor-heavenlydemonreborn",
  "compatibility_date": "2026-11-01",
  // Copies the published files into .cf-dist/heavenlydemonreborn/ so they are served under /heavenlydemonreborn/.
  "build": { "command": "sh scripts/cloudflare-build.sh" },
  "assets": {
    "directory": "./.cf-dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": true,
  // Test address while GitHub Pages still serves fellowsurvivor.com.
  "routes": [
    { "pattern": "new.fellowsurvivor.com/heavenlydemonreborn*", "zone_name": "fellowsurvivor.com" }
  ]
}
